# Toggle local dev mode that calls Business Central directly.
# false = use Power Automate flow service (Power Apps runtime path)
# true  = use local Business Central API + OAuth2 path
VITE_USE_LOCAL_BC_API=false

# Sandbox Business Central API settings
VITE_BC_TENANT_ID=00000000-0000-0000-0000-000000000000
VITE_BC_ENVIRONMENT=Sandbox
VITE_BC_COMPANY_ID=00000000-0000-0000-0000-000000000000
VITE_BC_API_PUBLISHER=microsoft
VITE_BC_API_GROUP=v2.0
VITE_BC_API_VERSION=v2.0

# Azure AD OAuth2 client credentials used for local DEV testing
VITE_BC_CLIENT_ID=00000000-0000-0000-0000-000000000000
VITE_BC_CLIENT_SECRET=replace-with-local-secret
VITE_BC_SCOPE=https://api.businesscentral.dynamics.com/.default

# Optional OData filter for customers endpoint
# Example: blocked eq false
VITE_BC_ODATA_FILTER=
